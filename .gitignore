# build output
build/
dist/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.class
*.jar
# ...except the Gradle wrapper, which HAS to be committed: it is what lets somebody clone this and
# build it without installing Gradle first.
!gradle/wrapper/gradle-wrapper.jar

# gradle
.gradle/

# reverse-engineering scratch -- these are large and machine-specific
tools/offsets_found.txt
*.i64
*.idb
*.til
*.nam
*.id0
*.id1
*.id2

# never commit a copy of the game -- it ships beside osclient.exe, so ignore the whole
# directory the client is kept in as well as the executable itself. game/ is where a local
# copy belongs: build/ is deleted by a clean, and that destroyed one on 2026-09-07.
osclient.exe
discord_game_sdk.dll
/game/

# editors
.vs/
.idea/
*.user

# per-machine agent settings (tool paths, permissions) -- never shared
.claude/settings.local.json

# the updater's working copies of the game and its analysis projects
/build/ghidra-*/
/build/fetch-test/


# generated by the Ghidra scripts against a copy of the game (see tools/ghidra_scripts/)
tools/decompiled/
tools/offsets_found.txt

# generated wiki output lives in wiki/ and IS committed; its build cache is not
wiki/.cache/
